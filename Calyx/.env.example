# ============================================================================
#  Calyx — environment TEMPLATE (tracked; NAMES ONLY, no secret values)
#  Copy to `.env` and fill in values. `.env` is gitignored. Doctrine §8c:
#  never commit a secret value — env-var names only.
# ============================================================================

# ── Cisco AnyConnect VPN (must be UP before SSH) ────────────────────────────
AIWONDER_VPN_SERVER=
AIWONDER_VPN_USER=
AIWONDER_VPN_PASSWORD=

# ── SSH into aiwonder ───────────────────────────────────────────────────────
AIWONDER_HOST=aiwonder.mst.com
AIWONDER_IP=
AIWONDER_SSH_PORT=22
AIWONDER_USER=croyse
AIWONDER_SSH_PASSWORD=
AIWONDER_SUDO_PASSWORD=

# ── Sole GameEditor Calyx root (binding #1503) ───────────────────────────
CALYX_HOME=C:\code\GameEditor\Calyx
CALYX_HOT_DATASET=
CALYX_COLD_DATASET=
CALYX_HOT_PATH=C:\code\GameEditor\Calyx\data
CALYX_COLD_PATH=C:\code\GameEditor\Calyx\archive
# Ephemeral workspace build output; #800 requires deletion after each owned run.
CALYX_CARGO_TARGET_DIR=C:\code\GameEditor\target
CALYX_RUST_ENV=
CALYX_ORT_LIB_DIR=C:\code\GameEditor\Calyx\ort-gpu-venv\Lib\site-packages\onnxruntime\capi
ORT_DYLIB_PATH=C:\code\GameEditor\Calyx\ort-gpu-venv\Lib\site-packages\onnxruntime\capi\onnxruntime.dll

# ── Resident services to reuse ──────────────────────────────────────────────
# Calyx-owned FP16 TEI dense lanes on the RTX 5090. `GENERAL` stays as the
# legacy/shared service name for compatibility; new default code uses E5.
AIWONDER_TEI_E5=http://127.0.0.1:18190
AIWONDER_TEI_BGE_M3=http://127.0.0.1:18188
AIWONDER_TEI_GENERAL=http://127.0.0.1:8088
AIWONDER_TEI_RERANKER=http://127.0.0.1:8089
AIWONDER_TEI_LEGAL=http://127.0.0.1:8090
AIWONDER_PROMETHEUS=http://127.0.0.1:9090

# ── Hugging Face ────────────────────────────────────────────────────────────
HF_TOKEN=
HF_HUB_TOKEN=
HF_HOME=C:\code\GameEditor\Calyx\.hf-cache

# ── GitHub dev-state surface ────────────────────────────────────────────────
CALYX_REPO=Light-in-the-Dark-Analytics/light-in-the-dark-game-engine
