# ── Claude Code local data ─────────────────────────────────────────────
# The .claude/ folder is tracked (skills, agents, commands, settings). Only two
# things must NEVER be committed: worktrees grew to 15+ GB, and credentials are
# secrets. Everything else in .claude/ is intentionally versioned.
.claude/worktrees/
.claude/.credentials.json

# ── Browser-automation scratch (console/page dumps) ─────────────────────
.playwright-mcp/

# ── Secrets ────────────────────────────────────────────────────────────
# .env.example templates are still tracked (pattern below only hits real ones).
**/.env
**/.env.local
**/.env.*.local
*.pem
*.key
*.pfx
*.p12

# ── OS / editor ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/

# ── Python bytecode caches ─────────────────────────────────────────────
__pycache__/
*.pyc

**/target/
/Cargo.lock.bak

# ── Scratch ────────────────────────────────────────────────────────────
/tmp/

# ── Local binary asset vault (downloaded libraries, never track) ────────
/local-asset-vault/

# ── Model caches (downloaded weights, multi-GB — never track) ───────────
.hf-cache/
target-area-cities/
target-area-regions/
target-area-dungeons/

# Local AgentDB session DB (not project source)
agentdb.db
agentdb.db-shm
agentdb.db-wal

