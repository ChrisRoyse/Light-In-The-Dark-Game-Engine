#!/usr/bin/env bash
# Calyx pre-push gate — rejects a push that leaks internal identifiers into
# public-bound source, or whose tree is not cargo-fmt clean.
#
# WHY: GitHub Actions is billing-disabled and `gh pr merge` runs server-side,
# so the ONLY place to stop unformatted code from reaching main is before it
# leaves this machine. PRs #530/#517/#475/#453 merged clippy+test-green but
# fmt-dirty and broke `cargo fmt --check` on main (see scripts/check.sh:19).
# This hook makes that class of breakage impossible to push.
#
# Install (once per clone): git config core.hooksPath .githooks
# (scripts/aiwonder-build-setup.sh does this automatically.)
#
# Fail-loud: if cargo is unavailable the push is REJECTED with a clear message
# rather than silently skipping the check.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Secret gate — reject real credentials before they leave this machine. Git's
# pre-push hook sends each ref update on stdin as:
#   <local-ref> <local-oid> <remote-ref> <remote-oid>
# Scan only the commits being pushed so old, already-reachable history does not
# mask the exact change that would leave this clone.
remote_name="${1:-origin}"
zero_oid='^0+$'

scan_push_range() {
  local local_ref="$1"
  local local_oid="$2"
  local remote_ref="$3"
  local remote_oid="$4"
  local log_opts

  if [[ -z "$local_ref" || -z "$local_oid" || -z "$remote_ref" || -z "$remote_oid" ]]; then
    echo "pre-push: ERROR — malformed pre-push ref update: '$local_ref' '$local_oid' '$remote_ref' '$remote_oid'." >&2
    exit 2
  fi

  if [[ "$local_oid" =~ $zero_oid ]]; then
    echo "pre-push: skipping delete of $remote_ref; no local commits are being pushed." >&2
    return 0
  fi

  if [[ "$remote_oid" =~ $zero_oid ]]; then
    log_opts="$local_oid --not --remotes=$remote_name"
  else
    log_opts="$remote_oid..$local_oid"
  fi

  local first_commit
  if ! first_commit="$(git rev-list --max-count=1 $log_opts)"; then
    echo "pre-push: ERROR — could not resolve pushed commit range for $local_ref -> $remote_ref: $log_opts" >&2
    exit 2
  fi

  if [[ -z "$first_commit" ]]; then
    echo "pre-push: no new commits to scan for $local_ref -> $remote_ref." >&2
    return 0
  fi

  echo "pre-push: scanning pushed commits for secrets: $local_ref -> $remote_ref ($log_opts)" >&2
  "$repo_root/scripts/secret-scan.sh" --git-log-opts "$log_opts"
}

ref_updates=0
while read -r local_ref local_oid remote_ref remote_oid; do
  [[ -n "${local_ref:-}" ]] || continue
  local_ref="${local_ref%$'\r'}"
  local_oid="${local_oid%$'\r'}"
  remote_ref="${remote_ref%$'\r'}"
  remote_oid="${remote_oid%$'\r'}"
  ref_updates=$((ref_updates + 1))
  scan_push_range "$local_ref" "$local_oid" "$remote_ref" "$remote_oid"
done

if [[ "$ref_updates" -eq 0 ]]; then
  echo "pre-push: ERROR — no ref updates received on stdin; refusing to skip secret verification." >&2
  exit 2
fi

# Public-source leak gate (no cargo needed) — reject internal infra identifiers
# in public-bound paths before they leave this machine. See
# scripts/public-leak-scan.sh.
echo "pre-push: scanning public-bound source for internal identifiers ..." >&2
"$repo_root/scripts/public-leak-scan.sh"

if [[ -f "$HOME/.cargo/env" ]]; then source "$HOME/.cargo/env"; fi

if ! command -v cargo >/dev/null 2>&1; then
  echo "pre-push: ERROR — cargo not found on PATH; cannot verify formatting." >&2
  echo "pre-push: install Rust or fix PATH, then retry. Refusing to push unverified." >&2
  exit 1
fi

echo "pre-push: workspace package fmt check ..." >&2
if ! bash "$repo_root/scripts/cargo-fmt-workspace.sh" --check; then
  echo "" >&2
  echo "pre-push: REJECTED — code is not cargo-fmt clean (files listed above)." >&2
  echo "pre-push: run \`bash scripts/cargo-fmt-workspace.sh --write\` and commit the result, then push again." >&2
  echo "pre-push: on native Windows, run \`pwsh -File scripts/cargo-fmt-workspace.ps1 -Write\`." >&2
  exit 1
fi
echo "pre-push: fmt clean — push allowed." >&2
